# Repository template: review docs/DEPLOYMENT.md before installing on a server.
raylonkai.dev {
	encode zstd gzip
	log
	header X-Content-Type-Options nosniff

	# Retain hashed assets across releases for old tabs and rollback.
	# handle preserves /assets/ in the path; shared/assets/ contains the files.
	handle /assets/* {
		root * /srv/raylonkai.dev/shared
		@existingAsset file
		header @existingAsset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Application paths reach React; unknown paths render its 404 view.
	handle {
		root * /srv/raylonkai.dev/current
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
